{
  "name": "morrow",
  "version": "0.1.0",
  "description": "A deployable workspace for eve agents. Don't wait for tomorrow—deploy with Morrow",
  "author": "Logan Dziuk",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gocougs2020/morrow.git"
  },
  "bugs": {
    "url": "https://github.com/gocougs2020/morrow/issues"
  },
  "homepage": "https://github.com/gocougs2020/morrow#readme",
  "keywords": [
    "eve",
    "ai-agent",
    "nextjs",
    "better-auth",
    "vercel"
  ],
  "type": "module",
  "imports": {
    "#*": "./agent/*",
    "#evals/*": "./evals/*"
  },
  "scripts": {
    "build": "next build",
    "deploy": "eve deploy",
    "dev": "next dev",
    "eval": "eve eval",
    "start": "next start",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:eve": "eve build",
    "dev:eve": "eve dev",
    "start:eve": "eve start",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate"
  },

    "@vercel/blob": "^2.8.0",
    "@xyflow/react": "^12.11.5",
    "ai": "^7.0.58",
    "ansi-to-react": "^6.2.6",
    "better-auth": "^1.7.1",
    "better-sqlite3": "^12.11.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "^0.45.2",
    "embla-carousel-react": "^8.6.0",
    "eve": "0.47.3",

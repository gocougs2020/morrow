# Product defaults (app name, home copy, skills, models) live in app.config.ts.
# Until ALLOWED_SIGNUP_EMAILS or ALLOWED_SIGNUP_DOMAINS is set, the home page
# shows a setup checklist. README.md Quick start has the full walkthrough.

# Better Auth
BETTER_AUTH_SECRET=
# Local default. Production must set this to your canonical origin
# (https://your-domain.com) on the Vercel project — not in source.
# Clones and forks do not inherit a production host; set your own.
BETTER_AUTH_URL=http://localhost:3000

# Optional access allowlist (comma-separated). Set here or on the Vercel project —
# do not put emails or domains in app.config.ts.
# When both allowlists are empty, anyone can create an account and stay signed in,
# except BLOCKED_ACCESS_EMAILS.
# ALLOWED_SIGNUP_EMAILS=ada@agency.com,sam@agency.com
# ALLOWED_SIGNUP_DOMAINS=agency.com
# BLOCKED_ACCESS_EMAILS=former.colleague@agency.com

# Optional. Comma-separated emails that can see the Account usage tab (all users' spend).
# When empty, only the You tab is shown.
# ALLOWED_ACCOUNT_USAGE_EMAILS=ada@agency.com

# Local soak tests only. Set to 1 to skip the in-process rate limiter.
# Ignored when NODE_ENV=production.
# RATE_LIMIT_DISABLED=1

# Optional. Personal token from https://vercel.com/account/tokens so the app can
# read the team billing plan. Without it, schedules stay Hobby-safe: at most
# once a day. Pro or Enterprise unlocks hourly and minute-level jobs after a
# redeploy. Vercel already injects VERCEL_ORG_ID on the project.
# VERCEL_TOKEN=

# Optional. Shared secret for unattended schedule and inbound-email session
# starts. Falls back to RESEND_WEBHOOK_SECRET, then BETTER_AUTH_SECRET.
# EMAIL_SESSION_SECRET=

# Neon (production). When unset, local SQLite + JSON store is used.
DATABASE_URL=

# Vercel Blob — private document files and file-memory sticky notes.
# Local fallback is .data/blobs/ (documents) and in-memory (file memory).
BLOB_READ_WRITE_TOKEN=

# AI Gateway (OIDC via `vercel env pull` or a static key)
AI_GATEWAY_API_KEY=

# OpenAI — used for voice transcription (gpt-transcribe)
OPENAI_API_KEY=

# Isolate this project's microsandbox 0.5.x state from a newer shared
# ~/.microsandbox database (required after a 0.6.x runtime has migrated it).
MSB_HOME=.eve/msb-home

# Resend — signup verification From, plus the mailbox used to build each
# user's agent+token send/receive address. Production signup needs
# RESEND_API_KEY. Local npm run dev without it prints the verification URL
# in the server log. Verify the sending domain so plus-addresses can send.
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
RESEND_FROM_EMAIL=
# Optional extra mailboxes that can host user plus-addresses.
# RESEND_INBOUND_ADDRESSES=agent@yourdomain.com,inbox@yourdomain.com
# RESEND_INBOUND_DOMAINS=inbound.yourdomain.com
